{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tatak",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-04-01",
	"assets": {
		// Unknown paths like /s/kape-ni-juan load the React app.
		"not_found_handling": "single-page-application",
		// Only API calls run the Worker. Page and file requests are free and unlimited.
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tatak",
			"database_id": "473ebeaf-c227-4fc8-8829-6d57ef8359ac",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}